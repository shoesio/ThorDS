+
+# Private console/game data is deliberately kept outside package sources. A
+# local test build may opt in by mounting a payload and setting this variable.
+rm -rf "${rootfs_dir}/opt/thords-testdata"
+if [[ -n "${THORDS_TESTDATA_DIR:-}" ]]; then
+  [[ -d "${THORDS_TESTDATA_DIR}" ]] || die "THORDS_TESTDATA_DIR is not a directory: ${THORDS_TESTDATA_DIR}"
+  log "staging local ThorDS test payload"
+  install -d -m 0700 "${rootfs_dir}/opt/thords-testdata"
+  rsync -a "${THORDS_TESTDATA_DIR}/" "${rootfs_dir}/opt/thords-testdata/"
+  run_rootfs "chown -R ${THORCH_USER}:${THORCH_USER} /opt/thords-testdata && find /opt/thords-testdata -type d -exec chmod 0700 {} + && find /opt/thords-testdata -type f -exec chmod 0600 {} +"
+fi
