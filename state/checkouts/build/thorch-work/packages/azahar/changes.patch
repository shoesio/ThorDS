@@ -19,12 +19,52 @@
 #include "core/hle/service/ptm/ptm_sets.h"
 #include "core/hle/service/ptm/ptm_sysm.h"
 #include "core/hle/service/ptm/ptm_u.h"
+#include <algorithm>
+#include <fstream>
+#include <string>
 
 SERIALIZE_EXPORT_IMPL(Service::PTM::Module)
 SERVICE_CONSTRUCT_IMPL(Service::PTM::Module)
 
 namespace Service::PTM {
 
+namespace {
+
+constexpr const char* BatteryCapacityPath = "/sys/class/power_supply/battery/capacity";
+constexpr const char* BatteryStatusPath = "/sys/class/power_supply/battery/status";
+
+} // Anonymous namespace
+
+HostBatteryState GetHostBatteryState() {
+    HostBatteryState state{};
+
+    std::ifstream capacity_file(BatteryCapacityPath);
+    int capacity = 100;
+    if (capacity_file >> capacity) {
+        capacity = std::clamp(capacity, 0, 100);
+        if (capacity <= 5) {
+            state.charge_level = ChargeLevels::CriticalBattery;
+        } else if (capacity <= 20) {
+            state.charge_level = ChargeLevels::LowBattery;
+        } else if (capacity <= 50) {
+            state.charge_level = ChargeLevels::HalfFull;
+        } else if (capacity <= 80) {
+            state.charge_level = ChargeLevels::MostlyFull;
+        } else {
+            state.charge_level = ChargeLevels::CompletelyFull;
+        }
+    }
+
+    std::ifstream status_file(BatteryStatusPath);
+    std::string status;
+    if (status_file >> status) {
+        state.is_charging = status == "Charging";
+        state.adapter_connected = state.is_charging || status == "Full" || status == "Not charging";
+    }
+
+    return state;
+}
