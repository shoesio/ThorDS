     case 1:
-        return texture(screen_textures[1], frag_tex_coord);
+        return ReadScreen(screen_textures[1]);
     case 2:
-        return texture(screen_textures[2], frag_tex_coord);
+        return ReadScreen(screen_textures[2]);
     }
 #endif
 }
