+           (value == "Charging" || value == "Full" || value == "Not charging");
+}
+
+static u8 HostBatteryLevel() {
+    std::ifstream capacity("/sys/class/power_supply/battery/capacity");
+    unsigned int value = 100;
+    if (!(capacity >> value)) return static_cast<u8>(Service::PTM::ChargeLevels::CompletelyFull);
+    if (value <= 10) return static_cast<u8>(Service::PTM::ChargeLevels::CriticalBattery);
+    if (value <= 30) return static_cast<u8>(Service::PTM::ChargeLevels::LowBattery);
+    if (value <= 55) return static_cast<u8>(Service::PTM::ChargeLevels::HalfFull);
+    if (value <= 80) return static_cast<u8>(Service::PTM::ChargeLevels::MostlyFull);
+    return static_cast<u8>(Service::PTM::ChargeLevels::CompletelyFull);
+}
