[Unit]
Description=ThorDS gyro and accelerometer for Azahar
Wants=thords-sensors.service
After=thords-sensors.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/libexec/thords/thords-motion.py
User=thords
Group=thords
RuntimeDirectory=thords-motion
Restart=on-failure
RestartSec=5
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
