#!/usr/bin/env bash
set -euo pipefail

config="${HOME}/.config/azaharplus-emu/qt-config.ini"
[[ -f "$config" ]] || exit 0

set_setting() {
  local key=$1 value=$2
  sed -i "s|^${key}=.*|${key}=${value}|" "$config"
  sed -i "s|^${key}\\\\default=.*|${key}\\\\default=false|" "$config"
}

set_setting resolution_factor 3
set_setting async_shader_compilation true
set_setting async_presentation true
set_setting use_hw_shader true
set_setting use_disk_shader_cache true
set_setting shaders_accurate_mul false
set_setting disable_right_eye_render true
set_setting filter_mode false
set_setting spirv_shader_gen true
set_setting use_vsync true
set_setting frame_limit 100
set_setting cpu_clock_percentage 100
